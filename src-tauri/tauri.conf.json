{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notchfy",
  "version": "0.1.3",
  "identifier": "app.notchfy.hard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Barra interativa no topo da tela",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QzQ1NTkzOUM4MURDRTAKUldUZzNJR2NrMVhFWm5KN0d1TzZVVkRWM3RaUGlzeWtpZGwvei9CY3lLRlM1ZWdVcENCYzBUK2EK",
      "endpoints": [
        "https://github.com/maxtryhard/Notify-Releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
